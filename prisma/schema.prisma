// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Shopify session storage (required by @shopify/shopify-app-session-storage-prisma) ---

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// --- Application domain model ---

enum Plan {
  FREE
  PRO
}

// Mirrors Shopify's AppSubscription status values so we can react to
// webhooks/live checks without inventing our own vocabulary.
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  DECLINED
  EXPIRED
  FROZEN
  PENDING
}

model Shop {
  id     String @id @default(cuid())
  domain String @unique

  plan               Plan                @default(FREE)
  subscriptionId     String? // Shopify AppSubscription GID, null while on FREE
  subscriptionStatus SubscriptionStatus?
  planUpdatedAt      DateTime            @default(now())

  // Widget customization — paid-plan-only fields, enforced server-side in
  // the settings action, not by omitting the columns.
  widgetPrimaryColor String @default("#1A1A1A")
  widgetLayout       String @default("grid") // "grid" | "list" | "carousel"

  // Post-purchase review request emails. Off until the merchant turns it
  // on — never send unsolicited emails to a merchant's customers just
  // because the feature exists. Available on every plan.
  reviewRequestsEnabled  Boolean @default(false)
  reviewRequestDelayDays Int     @default(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews            Review[]
  reviewRequests     ReviewRequest[]
  reviewImportBatches ReviewImportBatch[]

  @@index([plan])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewSource {
  STOREFRONT // submitted directly on the storefront widget
  EMAIL_REQUEST // submitted via the post-purchase email link
  IMPORTED // brought in via a merchant-uploaded CSV, see ReviewImportBatch
}

enum ImportMarketplace {
  ALIEXPRESS
  AMAZON
  ETSY
  SHOPEE
  OTHER
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Review {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  productId    String // Shopify Product GID
  productTitle String?

  rating      Int // 1-5, validated server-side
  authorName  String
  authorEmail String?
  body        String

  status ReviewStatus @default(PENDING)
  source ReviewSource @default(STOREFRONT)

  // Import-only metadata, all nullable — untouched (stays NULL) for every
  // review created through the existing storefront/email flows. See
  // ReviewImportBatch and review-import.server.ts.
  importMarketplace ImportMarketplace?
  importBatchId     String?
  // sha256 of shopId+productId+marketplace+authorName+rating+body+sourceCreatedAt,
  // computed at import time. Lets re-uploading the same (or an overlapping)
  // CSV never create duplicate rows — @@unique below enforces it. Postgres
  // allows unlimited NULLs in a unique column, so non-imported reviews
  // (always NULL here) are unaffected.
  importDedupeKey String?
  // Original review date on the source marketplace, display-only. Never
  // used for sorting — createdAt (below) stays "when this row entered our
  // database" everywhere, exactly as it does today.
  sourceCreatedAt DateTime?
  sourceReviewUrl String?

  // Set once, at creation. Never updated afterwards, and never cleared by
  // plan changes — this timestamp is what "50 most relevant reviews" on the
  // free plan is computed from (newest first), so downgrading a shop can
  // never delete or reorder history, only cap how many are *displayed*.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos ReviewPhoto[]

  @@unique([shopId, importDedupeKey])
  @@index([shopId, productId, status, createdAt])
}

// One row per CSV a merchant uploads through /app/reviews/import. Exists so
// every import is auditable and its per-row outcome is visible to the
// merchant — no result is ever silently swallowed.
model ReviewImportBatch {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  marketplace ImportMarketplace
  filename    String
  status      ImportBatchStatus @default(PROCESSING)

  totalRows             Int @default(0)
  importedCount         Int @default(0)
  skippedDuplicateCount Int @default(0)
  errorCount            Int @default(0)
  // First ~200 row errors, serialized as JSON. Capped so a pathological CSV
  // can't grow this column unbounded.
  errorSummary String?

  createdBy   String // staff email from the session, same convention as AuditLog.actor
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([shopId, createdAt])
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  url String

  createdAt DateTime @default(now())
}

// One row per "please review your purchase" email we intend to send.
// Created from the orders/paid webhook, consumed by a scheduled job that
// actually sends the email (see app/services/review-requests.server.ts).
model ReviewRequest {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  orderId       String // Shopify Order GID
  customerEmail String
  productId     String
  productTitle  String?
  // Storefront URL slug, fetched from the Admin API when this row is
  // created. Null if the product was deleted before we could look it up —
  // see sendDueReviewRequests, which skips (rather than guesses a link for)
  // a row in that state.
  productHandle String?

  token String @unique // unguessable, used in the emailed review link

  sendAt      DateTime // when the job should send this (order date + delay)
  sentAt      DateTime?
  completedAt DateTime? // set when the customer actually submits a review

  createdAt DateTime @default(now())

  @@index([shopId, sendAt, sentAt])
  @@unique([shopId, orderId, productId])
}

// Backs rate limiting on the public (unauthenticated) app proxy endpoints.
// One row per request attempt, keyed by a caller-chosen string (e.g.
// "submit:<ip>"). DB-backed rather than in-memory so a Render restart or
// cold start never resets an attacker's counter back to zero — see
// app/utils/rate-limit.server.ts.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Records who did what to personal data, and when — answers "do you log
// access to personal data?" with an actual log, not just a policy
// statement. actor is the Shopify staff account email from the session
// (there's only ever one merchant user per shop here, but this is future-
// proof if that ever changes); shopId has no relation/cascade on purpose
// so a log entry survives even if the shop itself is later deleted.
model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

// A single running counter of bytes uploaded to Supabase Storage, kept in
// our own DB instead of asking Supabase's Storage API to sum folder sizes
// (its list endpoint isn't recursive, and we shard uploads under one
// subfolder per shop). There's exactly one row ("global"); incremented in
// storage.server.ts on every successful upload, read by the daily
// low-storage-warning cron.
model StorageUsage {
  id          String    @id @default("global")
  totalBytes  BigInt    @default(0)
  lastAlertAt DateTime?
  updatedAt   DateTime  @updatedAt
}

# Copy this file to .env and fill in real values. Never commit .env.

# --- Shopify app credentials (from Partners > your app > Client credentials,
# filled in automatically by `npm run config:link`) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_orders
SHOPIFY_APP_URL=https://replace-with-your-app-url.example.com

# --- Database (PostgreSQL) ---
# For local dev, use a local Postgres container — keeps test data
# completely separate from production, which is set directly in Render's
# dashboard (not read from this file):
#   docker run -d --name keepreviews-dev-db -e POSTGRES_PASSWORD=devpassword \
#     -e POSTGRES_DB=keepreviews_dev -p 5433:5432 postgres:16
DATABASE_URL=postgresql://postgres:devpassword@localhost:5433/keepreviews_dev

# --- Review photos (Pro plan only). Uses Supabase Storage on the same
# project as DATABASE_URL — no extra vendor. One-time setup required:
#   1. Supabase dashboard > Storage > New bucket > name it "review-photos",
#      mark it Public (photos need to be viewable on the storefront).
#   2. Supabase dashboard > Settings > API > copy the "service_role" key
#      (NOT the anon key — this one bypasses row-level security, keep it
#      server-side only, never expose it to the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=review-photos

# --- Billing ---
# Price is intentionally NOT hardcoded in code — see app/config/plans.server.ts.
PRO_PLAN_PRICE_USD=9.99

# --- Post-purchase review request emails ---
# Whether to send them at all, and how many days to wait, are per-shop
# settings the merchant controls in /app/settings — not env vars.
# Resend (resend.com) free tier: 100 emails/day, no credit card required.
# Leave both empty in local dev to log emails instead of sending them.
RESEND_API_KEY=
REVIEW_REQUEST_FROM_EMAIL=

# Shared secret the external cron (see .github/workflows/send-review-requests.yml
# and check-storage-usage.yml) must send to trigger /cron/* routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Low-storage warning ---
# Where to send the "Supabase Storage is almost full" email from
# /cron/check-storage-usage (see .github/workflows/check-storage-usage.yml).
# This is an internal ops alert, not merchant-facing — use your own inbox.
ALERT_EMAIL=
